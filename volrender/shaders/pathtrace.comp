#version 430

// Path-trace compute shader — Steps 5–8.
// Primary ray generation, AABB intersection, debug fixed-step raymarch (Step 5),
// delta-tracked free flight with weighted null-scattering (Step 6),
// Henyey-Greenstein scattering bounce loop with RR (Step 7),
// and sun NEE via ratio-tracked shadow rays (Step 8).
// Progressive accumulation in Step 9.

layout(local_size_x = 8, local_size_y = 8) in;

// ---- common.glsl (prepended) provides: ----
// uniform vec3  u_bounds_min, u_bounds_max, u_resolution;
// uniform float u_voxel_volume;
// vec3 world_to_grid(vec3), vec3 grid_to_world(vec3)
// RNG: rng_state, rng_init(), next_float(), next_float3()
// vec3 sample_sphere()
// bool intersect_aabb(origin, dir, box_min, box_max, out t_near, out t_far)
//
// ---- volume_scene.glsl (prepended) provides: ----
// vec2 scene(vec3 p), vec3 sdf_normal(vec3 p)
// bool trace_sdf(...), bool sdf_shadow_test(...)
// vec3 sample_brdf(...), vec3 eval_brdf_cos(...)

// ---- SDF scene enable ----
uniform bool u_sdf_enabled;    // false = media-only (existing behavior)

// ---- camera ----
uniform mat4  u_inv_view_proj;

// ---- target ----
uniform ivec2 u_target_size;       // (width, height) of output image

// ---- stereogram region ----
// When u_region_size.x <= 0, the whole target is one view (default). Otherwise
// this dispatch covers only a sub-rectangle: output pixels are offset by
// u_region_offset and NDC is computed relative to u_region_size (so the eye
// camera fills exactly its half of the screen with a half-width aspect).
uniform ivec2 u_region_offset;     // pixel offset of this region's origin
uniform ivec2 u_region_size;       // (width, height) of this region; <=0 = full

// ---- debug mode ----
uniform bool  u_debug_raymarch;    // true = fixed-step debug, false = delta tracking
// COMMENT FLAG: u_debug_steps — number of fixed march steps (tune for quality vs. speed)
uniform int   u_debug_steps;

// ---- medium params ----
uniform vec3  u_extinction_rgb;
uniform float u_density_scale;
uniform float u_emission_strength;   // emission intensity multiplier (0 = off)

// ---- sky params (two-tone vertical gradient) ----
uniform vec3  u_sky_top;        // sky color at zenith (dir.y = +1)
uniform vec3  u_sky_bottom;     // sky color at nadir  (dir.y = -1)
uniform float u_sky_intensity;

// ---- albedo (Step 7, per-voxel hue from entity color) ----
uniform float u_albedo_saturation;   // saturation ceiling [0,1]
uniform float u_albedo_brightness;   // HSV value component [0,1]

// ---- bounce loop control (Step 7) ----
// COMMENT FLAG: max_bounces — 0 = unbounded (Russian roulette only)
uniform int   u_max_bounces;
// COMMENT FLAG: rr_start_depth — Russian roulette begins past this depth
uniform int   u_rr_start_depth;
// ---- HG phase function asymmetry ----
uniform float u_hg_g;            // [-1,1]: >0 forward, <0 back, 0 isotropic
uniform uint  u_sample_index;       // per-sample RNG seed offset
uniform bool  u_debug_delta_only;   // true = Step 6 visual mode (white/sky)
uniform bool  u_colored_extinction; // true = hue→extinction, false = hue→albedo

// ---- sun params (Step 8) ----
uniform vec3  u_sun_direction;     // unit, scene -> sun
uniform vec3  u_sun_color;         // sun color RGB
uniform float u_sun_intensity;     // sun radiance multiplier
uniform bool  u_sun_sampling;      // false = skip NEE shadow rays

// ---- photosphere / sky mode ----
uniform bool      u_use_photosphere;  // true = sample skybox texture
uniform sampler2D u_skybox;           // equirectangular skybox (texture unit 4)

// ---- depth of field ----
uniform float u_aperture;            // lens radius (0 = pinhole)
uniform float u_focal_plane_depth;   // distance to focal plane
uniform vec3  u_camera_right;        // camera right vector (world space)
uniform vec3  u_camera_up;           // camera up vector (world space)

// ---- density (trilinear filtered sampler) ----
uniform sampler3D u_density;

// ---- majorant grid (nearest-filtered sampler, coarse resolution) ----
uniform sampler3D u_majorant;
uniform ivec3     u_majorant_resolution;  // e.g. (32, 32, 32)

// ---- hue-color accumulation (trilinear filtered samplers) ----
uniform sampler3D u_color_x;              // accumulated cos(2*pi*hue) * weight
uniform sampler3D u_color_y;              // accumulated sin(2*pi*hue) * weight

// ---- firefly clamp ----
uniform bool  u_firefly_clamp;       // true = clamp per-sample radiance
uniform float u_firefly_clamp_max;   // max allowed luminance per sample

// ---- output image ----
layout(rgba16f, binding = 0) writeonly uniform image2D img_output;

// ---- accumulation image (Step 9) ----
// When u_accumulate is true, samples are additively accumulated into
// img_accum (rgba32f, read-write).  When false, the shader writes
// directly to img_output (rgba16f, writeonly) as in Steps 5–8.
layout(rgba32f, binding = 1) uniform image2D img_accum;
uniform bool u_accumulate;


// ====================================================================
// HSV -> RGB (same compact form used in frame_assembly.frag et al.)
// ====================================================================
vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}


// ====================================================================
// sRGB -> linear conversion helpers (for skybox texture).
// ====================================================================
vec3 LessThan(vec3 f, float value) {
    return vec3(
        (f.x < value) ? 1.0 : 0.0,
        (f.y < value) ? 1.0 : 0.0,
        (f.z < value) ? 1.0 : 0.0);
}

vec3 SRGBToLinear(vec3 rgb) {
    rgb = clamp(rgb, 0.0, 1.0);
    return mix(
        pow(((rgb + 0.055) / 1.055), vec3(2.4)),
        rgb / 12.92,
        LessThan(rgb, 0.04045));
}

// ====================================================================
// Sky color: direction-dependent sky radiance.
//
// In photosphere mode, samples an equirectangular skybox texture.
// Otherwise, returns a procedural sky with soft brightening toward
// the sun direction (low-frequency, no sharp sun disk).
// ====================================================================
vec3 get_sky_col(vec3 dir) {
    if (u_use_photosphere) {
        float theta = atan(dir.z, dir.x) / 3.141592653589793 / 2.0 + 0.5;
        float phi = dir.y / 2.0 + 0.5;
        return SRGBToLinear(texture(u_skybox, vec2(theta, phi)).xyz);
    }
    // Procedural: two-tone vertical gradient + soft brightening toward the sun.
    vec3 base = mix(u_sky_bottom, u_sky_top, clamp(dir.y * 0.5 + 0.5, 0.0, 1.0))
              * u_sky_intensity;
    float sun_dot = dot(dir, u_sun_direction);
    float sun_glow = pow(clamp(sun_dot * 0.5 + 0.5, 0.0, 1.0), 900.0);
    return base * (1.0 + sun_glow * 200.0);
}


// ====================================================================
// Per-voxel albedo from accumulated entity hue.
//
// Reconstructs mean hue from the circular-mean unit-vector (Cx, Cy),
// derives saturation from |C|/W (W = density = same trilinear weight
// sum), and returns HSV->RGB with user-controlled saturation ceiling
// and brightness.
//
// W ~ 0 fallback: when density is negligible, R -> 0, yielding a
// desaturated result.  Correct because albedo is irrelevant where
// there is no scattering medium.
//
// Single-particle edge case: a voxel with one contributing particle
// yields R = 1 (full saturation at that particle's exact hue).  This
// is correct, not a bug.
// ====================================================================
vec3 get_albedo(vec3 pos) {
    vec3 uvw = (pos - u_bounds_min) / (u_bounds_max - u_bounds_min);

    float cx = texture(u_color_x, uvw).r;
    float cy = texture(u_color_y, uvw).r;
    float W  = texture(u_density, uvw).r;   // density IS sum of weights

    // Reconstruct hue from accumulated unit vector direction
    float hue = atan(cy, cx) / 6.283185307;   // atan2(y,x) / 2pi
    hue = fract(hue);                          // wrap to [0, 1)

    // Concentration: |C| / W.  When W ~ 0, eps guard yields R -> 0.
    float C_len = length(vec2(cx, cy));
    float R = clamp(C_len / max(W, 1e-7), 0.0, 1.0);

    float S = u_albedo_saturation * R;
    float V = u_albedo_brightness;

    return hsv2rgb(vec3(hue, S, V));
}


// ====================================================================
// Per-voxel hue color for colored-extinction mode.
//
// Identical hue reconstruction as get_albedo, but used to tint the
// extinction coefficient.  When u_colored_extinction is true, the
// albedo uniforms (saturation, brightness) control extinction color
// instead.  Brightness MUST be <= 1.0 to keep the majorant valid
// (max channel of hsv2rgb with V<=1 is <= 1).
// ====================================================================
vec3 get_hue_color(vec3 pos) {
    vec3 uvw = (pos - u_bounds_min) / (u_bounds_max - u_bounds_min);

    float cx = texture(u_color_x, uvw).r;
    float cy = texture(u_color_y, uvw).r;
    float W  = texture(u_density, uvw).r;

    float hue = atan(cy, cx) / 6.283185307;
    hue = fract(hue);

    float C_len = length(vec2(cx, cy));
    float R = clamp(C_len / max(W, 1e-7), 0.0, 1.0);

    float S = u_albedo_saturation * R;
    float V = u_albedo_brightness;

    return hsv2rgb(vec3(hue, S, V));
}


// ====================================================================
// Helper: evaluate sigma_t_rgb at a world-space position.
//
// sigma_t = extinction_rgb * density_scale * physical_density(p)
// where physical_density = raw_density / voxel_volume  (density
// normalization convention — applied here and in the majorant build,
// nowhere else).
// ====================================================================
vec3 sigma_t_at(vec3 p) {
    vec3 uvw = (p - u_bounds_min) / (u_bounds_max - u_bounds_min);
    float raw_density = texture(u_density, uvw).r;
    float physical_density = raw_density / u_voxel_volume;
    if (u_colored_extinction) {
        // Hue-derived extinction: color from texture, no uniform tint
        return get_hue_color(p) * u_density_scale * physical_density;
    } else {
        // Legacy: uniform extinction color
        return u_extinction_rgb * u_density_scale * physical_density;
    }
}


// ====================================================================
// Emitted radiance L_e from local density.
//
// Returns a color (vec3) representing emission, NOT premultiplied by
// sigma_a.  The sigma_a weighting is handled by the caller (via the
// implicit absorption model's (1 - albedo) factor).
//
// Uses a soft-clamp curve: x/(1+x) to avoid blowup at high density
// while responding smoothly at low density.
// ====================================================================
vec3 blackbody(float Temp) {
    vec3 col = vec3(255.0);
    
    // Red approximation
    col.x = 56100000.0 * pow(Temp, -1.5) + 148.0;
    
    // Green approximation
    col.y = 100.04 * log(Temp) - 623.6;
    if (Temp > 6500.0) {
        col.y = 35200000.0 * pow(Temp, -1.5) + 184.0;
    }
    
    // Blue approximation
    col.z = 194.18 * log(Temp) - 1448.6;
    
    // Clamp to sRGB range [0, 255] and normalize to [0.0, 1.0]
    col = clamp(col, 0.0, 255.0) / 255.0;
    
    // Fade to black at very low temperatures
    if (Temp < 1000.0) {
        col *= Temp / 1000.0;
    }
    
    return col;
}
vec3 calc_emission(float density) {
    if (u_emission_strength <= 0.0) return vec3(0.0);
    float x = .00001*density * u_emission_strength;

    //x-=0;
    float luminance = .01*x*x*x*x*x;//x / (1.0 + x);
    return vec3(luminance);
    //return 25*vec3(blackbody(max(x*x*x-300,0)));
}


// ====================================================================
// Delta-tracked free flight with weighted null-scattering (RGB).
//
// Walks the ray through the coarse majorant grid.  Within each coarse
// cell, samples tentative free-flight distances from the local
// majorant.  On a tentative event, evaluates the true extinction and
// stochastically accepts (real collision) or rejects (null collision),
// updating the RGB throughput either way for unbiased estimation.
//
// Returns true  if a real collision occurred (position in `hit_pos`).
// Returns false if the ray escaped the grid with no real collision.
//
// `throughput` is an inout RGB weight — caller initializes to vec3(1).
// The weighted delta-tracking factors keep colored extinction unbiased
// under a single scalar accept/reject decision.
//
// Steps 7–8 call this to find collision points, then handle scattering
// and NEE at the collision site.
// ====================================================================
bool sample_free_flight(vec3 origin, vec3 dir,
                        float t_enter, float t_exit,
                        inout vec3 throughput,
                        out vec3 hit_pos)
{
    float t = t_enter;

    // Coarse cell size in world space
    vec3 grid_extent = u_bounds_max - u_bounds_min;
    vec3 cell_size   = grid_extent / vec3(u_majorant_resolution);

    // Max extinction channel (constant across the ray)
    // In colored-extinction mode, hue color has max channel <= 1.0
    // (guaranteed by brightness uniform clamped to [0,1]).
    float max_ext = u_colored_extinction
        ? 1.0
        : max(u_extinction_rgb.r, max(u_extinction_rgb.g, u_extinction_rgb.b));

    // Precompute inverse direction for slab math
    vec3 inv_dir = 1.0 / dir;

    // COMMENT FLAG: MAX_DT_ITERS — safety cap on total delta-tracking
    // iterations.  Should never be reached in practice; increase if
    // the majorant grid is very fine or rays are very long.
    const int MAX_DT_ITERS = 2048;

    for (int iter = 0; iter < MAX_DT_ITERS; iter++) {

        // ---- Have we left the volume? ----
        if (t >= t_exit)
            return false;

        // ---- Current position on the ray ----
        vec3 p = origin + t * dir;

        // ---- Identify the coarse cell containing p ----
        vec3 coarse_gc = (p - u_bounds_min) / cell_size;
        ivec3 cell = ivec3(floor(coarse_gc));
        cell = clamp(cell, ivec3(0), u_majorant_resolution - 1);

        // ---- Parametric t at which the ray exits this cell ----
        vec3 cell_world_min = u_bounds_min + vec3(cell) * cell_size;
        vec3 cell_world_max = cell_world_min + cell_size;

        vec3 t_to_min = (cell_world_min - origin) * inv_dir;
        vec3 t_to_max = (cell_world_max - origin) * inv_dir;
        vec3 t_exit_planes = max(t_to_min, t_to_max);

        float t_cell_exit = min(t_exit_planes.x,
                            min(t_exit_planes.y, t_exit_planes.z));
        t_cell_exit = min(t_cell_exit, t_exit);
        // Guarantee forward progress: cell exit must be strictly ahead of t.
        // Prevents infinite loops when ray is near-parallel to cell boundaries.
        t_cell_exit = max(t_cell_exit, t + 1e-5);

        // ---- Look up majorant for this cell ----
        // Sample at cell center — nearest filtering reads the stored max.
        vec3 cell_center_uvw = (vec3(cell) + 0.5) / vec3(u_majorant_resolution);
        float majorant_density = texture(u_majorant, cell_center_uvw).r;
        float mu_bar = max_ext * u_density_scale * majorant_density;

        // ---- Empty cell: skip straight to boundary ----
        if (mu_bar <= 0.0) {
            t = t_cell_exit + 1e-5;
            continue;
        }

        // ---- Delta tracking within this cell ----
        bool left_cell = false;
        while (!left_cell) {
            // Sample exponential free-flight distance
            float xi = next_float();
            xi = max(xi, 1e-30);            // guard log(0)
            float dt = -log(1.0 - xi) / mu_bar;
            t += dt;

            // Overshot cell boundary → advance to next cell
            if (t >= t_cell_exit) {
                t = t_cell_exit + 1e-5;
                left_cell = true;
                break;
            }

            // Overshot volume → escaped
            if (t >= t_exit)
                return false;

            // ---- Tentative event at this position ----
            vec3 event_pos = origin + t * dir;
            vec3 sigma_t   = sigma_t_at(event_pos);

            // Scalar real-collision probability
            float sigma_max = max(sigma_t.r, max(sigma_t.g, sigma_t.b));
            float Pr = clamp(sigma_max / mu_bar, 0.0, 1.0);

            float xi2 = next_float();

            if (xi2 < Pr) {
                // ---- Real collision ----
                // Throughput weight: sigma_t / (mu_bar * Pr)
                throughput *= sigma_t / (mu_bar * Pr);
                hit_pos = event_pos;
                return true;
            } else {
                // ---- Null collision ----
                // Throughput weight: (mu_bar - sigma_t) / (mu_bar * (1 - Pr))
                float one_minus_Pr = max(1.0 - Pr, 1e-10);
                vec3 null_weight = (mu_bar - sigma_t) / (mu_bar * one_minus_Pr);
                // COMMENT FLAG: null_weight_clamp — cap per-channel null-collision
                // weight to reduce fireflies with strongly chromatic extinction.
                // Introduces slight bias but controls variance explosion.
                throughput *= clamp(null_weight, vec3(0.0), vec3(5.0));
            }
        }
    }

    // Safety: exceeded MAX_DT_ITERS (should not happen in practice)
    return false;
}


// ====================================================================
// Ratio-tracked transmittance toward the sun (RGB, unbiased).
//
// Marches from world-space position `x` along u_sun_direction until
// the ray exits the grid, accumulating the ratio-tracking weight at
// each tentative event.  Unlike delta tracking (sample_free_flight),
// ratio tracking does NOT make a real/null decision — every tentative
// event multiplicatively updates T.  This produces an unbiased RGB
// transmittance estimate with naturally colored shadows.
//
// T starts at vec3(1).  At each tentative event position x':
//   T *= (mu_bar_cell - sigma_t_rgb(x')) / mu_bar_cell
//
// Returns T after the ray exits the grid.
// ====================================================================
vec3 transmittance_to_sun(vec3 x) {
    vec3 dir = u_sun_direction;

    // SDF occlusion: opaque surfaces fully block light
    if (u_sdf_enabled) {
        if (sdf_shadow_test(x, dir, SDF_SURFACE_EPS * 10.0, SDF_MAX_DIST))
            return vec3(0.0);
    }

    // Intersect the shadow ray with the grid AABB
    float t_near, t_far;
    bool hit = intersect_aabb(x, dir, u_bounds_min, u_bounds_max,
                              t_near, t_far);
    if (!hit)
        return vec3(1.0);   // outside grid entirely

    // Origin is inside the grid, so t_near <= 0.
    // Start slightly ahead to avoid self-intersection.
    float t = max(t_near, 1e-5);

    vec3 T = vec3(1.0);

    // Coarse cell size in world space
    vec3 grid_extent = u_bounds_max - u_bounds_min;
    vec3 cell_size   = grid_extent / vec3(u_majorant_resolution);

    // Max extinction channel (constant)
    float max_ext = u_colored_extinction
        ? 1.0
        : max(u_extinction_rgb.r, max(u_extinction_rgb.g, u_extinction_rgb.b));

    // Precompute inverse direction for slab math
    vec3 inv_dir = 1.0 / dir;

    // COMMENT FLAG: MAX_SHADOW_ITERS — safety cap on ratio-tracking
    // iterations along the shadow ray.  Should never be reached in
    // practice; increase if the majorant grid is very fine.
    const int MAX_SHADOW_ITERS = 2048;

    for (int iter = 0; iter < MAX_SHADOW_ITERS; iter++) {

        // ---- Have we left the volume? ----
        if (t >= t_far)
            return T;

        // ---- Current position on the ray ----
        vec3 p = x + t * dir;

        // ---- Identify the coarse cell containing p ----
        vec3 coarse_gc = (p - u_bounds_min) / cell_size;
        ivec3 cell = ivec3(floor(coarse_gc));
        cell = clamp(cell, ivec3(0), u_majorant_resolution - 1);

        // ---- Parametric t at which the ray exits this cell ----
        vec3 cell_world_min = u_bounds_min + vec3(cell) * cell_size;
        vec3 cell_world_max = cell_world_min + cell_size;

        vec3 t_to_min = (cell_world_min - x) * inv_dir;
        vec3 t_to_max = (cell_world_max - x) * inv_dir;
        vec3 t_exit_planes = max(t_to_min, t_to_max);

        float t_cell_exit = min(t_exit_planes.x,
                            min(t_exit_planes.y, t_exit_planes.z));
        t_cell_exit = min(t_cell_exit, t_far);
        // Guarantee forward progress (same fix as sample_free_flight)
        t_cell_exit = max(t_cell_exit, t + 1e-5);

        // ---- Look up majorant for this cell ----
        vec3 cell_center_uvw = (vec3(cell) + 0.5) / vec3(u_majorant_resolution);
        float majorant_density = texture(u_majorant, cell_center_uvw).r;
        float mu_bar = max_ext * u_density_scale * majorant_density;

        // ---- Empty cell: skip straight to boundary ----
        if (mu_bar <= 0.0) {
            t = t_cell_exit + 1e-5;
            continue;
        }

        // ---- Ratio tracking within this cell ----
        bool left_cell = false;
        while (!left_cell) {
            // Sample exponential free-flight distance
            float xi = next_float();
            xi = max(xi, 1e-30);            // guard log(0)
            float dt = -log(1.0 - xi) / mu_bar;
            t += dt;

            // Overshot cell boundary → advance to next cell
            if (t >= t_cell_exit) {
                t = t_cell_exit + 1e-5;
                left_cell = true;
                break;
            }

            // Overshot volume → done
            if (t >= t_far)
                return T;

            // ---- Tentative event: ratio-tracking weight update ----
            // T *= (mu_bar - sigma_t) / mu_bar   (per channel)
            // No real/null decision — every event contributes.
            vec3 event_pos = x + t * dir;
            vec3 sigma_t   = sigma_t_at(event_pos);
            T *= clamp((mu_bar - sigma_t) / mu_bar, vec3(0.0), vec3(1.0));

            // Early termination: if T is negligibly small, stop
            if (max(T.r, max(T.g, T.b)) < 1e-6)
                return T;
        }
    }

    // Safety: exceeded MAX_SHADOW_ITERS
    return T;
}


// ====================================================================
// Accumulate-aware output: adds to img_accum when accumulating,
// writes to img_output otherwise.  (Step 9)
// ====================================================================
void write_output(ivec2 pixel, vec4 value) {
    if (u_accumulate) {
        imageStore(img_accum, pixel, imageLoad(img_accum, pixel) + value);
    } else {
        imageStore(img_output, pixel, value);
    }
}


void main() {
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);

    // Stereogram: this dispatch may cover only a sub-rectangle. The local
    // invocation id addresses the region; the output pixel and NDC basis are
    // derived from it. When u_region_size.x <= 0, region == full target.
    bool stereo_region = (u_region_size.x > 0);
    ivec2 region_size = stereo_region ? u_region_size : u_target_size;
    if (local.x >= region_size.x || local.y >= region_size.y)
        return;
    ivec2 pixel = stereo_region ? (local + u_region_offset) : local;

    // Initialize RNG early for subpixel jitter and DOF
    rng_init(uvec3(pixel, u_sample_index));

    // ---- 1. Build NDC with subpixel jitter (free AA over multiple samples) ----
    // NDC spans the region, so each eye camera fills its half at half aspect.
    vec2 uv = (vec2(local) + vec2(next_float(), next_float())) / vec2(region_size);
    vec2 ndc_xy = uv * 2.0 - 1.0;

    // ---- 2. Unproject near (z=-1) and far (z=+1) through inv_view_proj ----
    vec4 near_h = u_inv_view_proj * vec4(ndc_xy, -1.0, 1.0);
    vec4 far_h  = u_inv_view_proj * vec4(ndc_xy,  1.0, 1.0);
    vec3 near_w = near_h.xyz / near_h.w;
    vec3 far_w  = far_h.xyz / far_h.w;

    // ---- 3. Ray ----
    vec3 ray_origin = near_w;
    vec3 ray_dir    = normalize(far_w - near_w);

    // ---- 3b. Depth of field ----
    if (u_aperture > 0.0) {
        vec3 focal_point = ray_origin + ray_dir * u_focal_plane_depth;
        vec2 lens_offset = sample_disk() * u_aperture;
        ray_origin += u_camera_right * lens_offset.x + u_camera_up * lens_offset.y;
        ray_dir = normalize(focal_point - ray_origin);
    }

    // ---- 4. AABB slab intersection ----
    float t_near, t_far;
    bool hit = intersect_aabb(ray_origin, ray_dir,
                              u_bounds_min, u_bounds_max,
                              t_near, t_far);

    // ---- SDF primary ray test (before debug paths) ----
    float primary_sdf_t;
    vec2  primary_sdf_mat;
    bool  primary_sdf_hit = false;
    if (u_sdf_enabled) {
        primary_sdf_hit = trace_sdf(ray_origin, ray_dir,
                                     1e-4, SDF_MAX_DIST,
                                     primary_sdf_t, primary_sdf_mat);
    }

    if (!hit && !primary_sdf_hit) {
        write_output(pixel, vec4(get_sky_col(ray_dir), 1.0));
        return;
    }

    // ---- 5. Debug fixed-step raymarch ----
    if (u_debug_raymarch) {
        if (!hit) {
            write_output(pixel, vec4(get_sky_col(ray_dir), 1.0));
            return;
        }
        // Clamp t_near so camera can be inside the box
        t_near = max(t_near, 0.0);
        float path_length = t_far - t_near;
        float step_size = path_length / float(u_debug_steps);

        vec3 tau = vec3(0.0);  // optical depth accumulator (RGB)

        for (int i = 0; i < u_debug_steps; i++) {
            float t = t_near + (float(i) + 0.5) * step_size;
            vec3 p = ray_origin + t * ray_dir;

            vec3 sigma_t = sigma_t_at(p);
            tau += sigma_t * step_size;
        }

        // Transmittance composited over sky: color = sky * exp(-tau)
        vec3 transmittance = exp(-tau);
        vec3 color = get_sky_col(ray_dir) * transmittance;
        write_output(pixel, vec4(color, 1.0));
        return;
    }

    // ---- 6. Delta-tracked free flight (visual validation mode) ----
    if (u_debug_delta_only) {
        if (!hit) {
            write_output(pixel, vec4(get_sky_col(ray_dir), 1.0));
            return;
        }
        rng_init(uvec3(pixel, 0u));
        t_near = max(t_near, 0.0);

        vec3 throughput_dt = vec3(1.0);
        vec3 hit_pos_dt;
        bool collided = sample_free_flight(ray_origin, ray_dir,
                                           t_near, t_far,
                                           throughput_dt, hit_pos_dt);
        if (collided) {
            write_output(pixel, vec4(1.0, 1.0, 1.0, 1.0));
        } else {
            write_output(pixel, vec4(get_sky_col(ray_dir), 1.0));
        }
        return;
    }

    // ---- 7. Bounce loop (media scattering + SDF surfaces) ----
    // Full random walk handling both participating media (delta tracking)
    // and SDF surfaces (sphere tracing).  At each bounce, the ray tests
    // both systems and picks whichever intersection is closer.

    vec3 throughput = vec3(1.0);
    vec3 radiance   = vec3(0.0);
    int  depth      = 0;

    vec3 walk_origin = ray_origin;
    vec3 walk_dir    = ray_dir;

    // COMMENT FLAG: MAX_WALK_BOUNCES — absolute safety cap on walk length.
    const int MAX_WALK_BOUNCES = 512;

    for (int bounce = 0; bounce < MAX_WALK_BOUNCES; bounce++) {

        // ---- Determine intersection candidates ----

        // 1. SDF intersection
        float sdf_t = SDF_MAX_DIST + 1.0;
        vec2  sdf_mat = vec2(0.0);
        bool  sdf_hit = false;
        if (u_sdf_enabled) {
            sdf_hit = trace_sdf(walk_origin, walk_dir,
                                SDF_SURFACE_EPS * 2.0, SDF_MAX_DIST,
                                sdf_t, sdf_mat);
        }

        // 2. AABB (media) intersection
        float aabb_t_near, aabb_t_far;
        bool  aabb_hit = intersect_aabb(walk_origin, walk_dir,
                                        u_bounds_min, u_bounds_max,
                                        aabb_t_near, aabb_t_far);
        if (aabb_hit)
            aabb_t_near = max(aabb_t_near, 1e-5);

        // ---- No intersection at all → sky escape ----
        if (!sdf_hit && !aabb_hit) {
            radiance += throughput * get_sky_col(walk_dir);
            break;
        }

        // ---- Determine what happens first ----
        // surface_interaction = true means SDF surface, false means media scatter
        bool surface_interaction = false;
        vec3 hit_pos;

        bool try_media = aabb_hit && (!sdf_hit || aabb_t_near < sdf_t);

        if (try_media) {
            // Media AABB is the closer candidate (or SDF not hit).
            // Delta-track through media, but clip t_far at SDF hit distance
            // so that tracking stops if the ray reaches the SDF surface
            // without a media collision.
            float effective_t_far = aabb_t_far;
            if (sdf_hit)
                effective_t_far = min(effective_t_far, sdf_t);

            vec3 dt_throughput = vec3(1.0);
            bool collided = sample_free_flight(walk_origin, walk_dir,
                                               aabb_t_near, effective_t_far,
                                               dt_throughput, hit_pos);
            throughput *= dt_throughput;

            if (collided) {
                // Media scatter — hit_pos set by sample_free_flight
                surface_interaction = false;
            } else if (sdf_hit && effective_t_far <= sdf_t + 1e-4) {
                // Passed through media without collision, reached SDF surface
                surface_interaction = true;
                hit_pos = walk_origin + sdf_t * walk_dir;
                sdf_mat = scene(hit_pos);
            } else {
                // Escaped AABB, no SDF beyond → sky
                radiance += throughput * get_sky_col(walk_dir);
                break;
            }
        } else {
            // SDF is closer than media entry (or no media hit)
            surface_interaction = true;
            hit_pos = walk_origin + sdf_t * walk_dir;
        }

        // ---- Handle the interaction ----

        if (!surface_interaction) {
            // ---- Media scatter ----

            // Compute albedo for this collision (needed for both
            // emission weighting and the scattering throughput update)
            vec3 albedo_here;
            if (u_colored_extinction) {
                albedo_here = u_extinction_rgb;
            } else {
                albedo_here = get_albedo(hit_pos);
            }

            // ---- Emission (Kirchhoff: tied to absorption) ----
            // Case (b): implicit absorption — weight by (1 - albedo)
            // which equals sigma_a / sigma_t at this collision.
            if (u_emission_strength > 0.0) {
                vec3 uvw = (hit_pos - u_bounds_min) / (u_bounds_max - u_bounds_min);
                float raw_density = texture(u_density, uvw).r;
                float physical_density = raw_density / u_voxel_volume;
                vec3 Le = calc_emission(physical_density);
                radiance += throughput * (vec3(1.0) - albedo_here) * Le;
            }

            // Apply albedo (scattering probability)
            throughput *= albedo_here;

            // Sun NEE: HG phase function toward sun
            if (u_sun_sampling) {
                vec3 T_sun = transmittance_to_sun(hit_pos);
                float cos_theta = dot(walk_dir, u_sun_direction);
                float phase = hg_phase(cos_theta, u_hg_g);
                radiance += throughput * phase * T_sun
                            * u_sun_color * u_sun_intensity;
            }

            depth += 1;

            // Max bounces termination
            if (u_max_bounces > 0 && depth >= u_max_bounces)
                break;

            // Russian roulette
            if (depth > u_rr_start_depth) {
                float p_survive = max(throughput.r, max(throughput.g, throughput.b));
                p_survive = clamp(p_survive, 0.05, 1.0);
                if (next_float() >= p_survive) break;
                throughput /= p_survive;
            }

            // HG scatter (importance-sampled; isotropic when g=0)
            walk_dir = sample_hg(walk_dir, u_hg_g);
            walk_origin = hit_pos;

        } else {
            // ---- SDF surface interaction ----
            vec3 N = sdf_normal(hit_pos);
            // Ensure normal faces the incoming ray
            if (dot(N, walk_dir) > 0.0) N = -N;

            // Sun NEE for surfaces (BRDF-weighted)
            // Offset shadow origin along normal to avoid self-shadowing
            if (u_sun_sampling) {
                vec3 shadow_origin = hit_pos + N * SDF_SURFACE_EPS * 4.0;
                vec3 T_sun = transmittance_to_sun(shadow_origin);
                vec3 brdf_cos = eval_brdf_cos(walk_dir, u_sun_direction,
                                               N, sdf_mat,hit_pos);
                radiance += throughput * brdf_cos * T_sun
                            * u_sun_color * u_sun_intensity;
            }

            depth += 1;

            if (u_max_bounces > 0 && depth >= u_max_bounces)
                break;

            if (depth > u_rr_start_depth) {
                float p_survive = max(throughput.r, max(throughput.g, throughput.b));
                p_survive = clamp(p_survive, 0.05, 1.0);
                if (next_float() >= p_survive) break;
                throughput /= p_survive;
            }

            // Sample BRDF for next bounce direction
            vec3 bounce_dir;
            vec3 brdf_weight = sample_brdf(walk_dir, N, sdf_mat,hit_pos, bounce_dir);
            throughput *= brdf_weight;
            walk_dir = bounce_dir;
            // Offset origin along normal to prevent self-intersection
            walk_origin = hit_pos + N * SDF_SURFACE_EPS * 2.0;
        }
    }

    // Per-sample firefly clamp: cap radiance magnitude to reduce outliers
    if (u_firefly_clamp) {
        float lum = max(radiance.r, max(radiance.g, radiance.b));
        if (lum > u_firefly_clamp_max) {
            radiance *= u_firefly_clamp_max / lum;
        }
    }

    write_output(pixel, vec4(radiance, 1.0));
}
