#version 430

// Path-trace compute shader — Steps 5–8.
// Primary ray generation, AABB intersection, debug fixed-step raymarch (Step 5),
// delta-tracked free flight with weighted null-scattering (Step 6),
// isotropic scattering bounce loop with RR (Step 7),
// and sun NEE via ratio-tracked shadow rays (Step 8).
// Progressive accumulation in Step 9.

layout(local_size_x = 8, local_size_y = 8) in;

// ---- common.glsl (prepended) provides: ----
// uniform vec3  u_bounds_min, u_bounds_max, u_resolution;
// uniform float u_voxel_volume;
// vec3 world_to_grid(vec3), vec3 grid_to_world(vec3)
// RNG: rng_state, rng_init(), next_float(), next_float3()
// bool intersect_aabb(origin, dir, box_min, box_max, out t_near, out t_far)

// ---- camera ----
uniform mat4  u_inv_view_proj;

// ---- target ----
uniform ivec2 u_target_size;       // (width, height) of output image

// ---- debug mode ----
uniform bool  u_debug_raymarch;    // true = fixed-step debug, false = delta tracking
// COMMENT FLAG: u_debug_steps — number of fixed march steps (tune for quality vs. speed)
uniform int   u_debug_steps;

// ---- medium params ----
uniform vec3  u_extinction_rgb;
uniform float u_density_scale;

// ---- sky params ----
uniform vec3  u_sky_color;
uniform float u_sky_intensity;

// ---- albedo (Step 7) ----
uniform vec3  u_albedo_rgb;         // single-scatter albedo

// ---- bounce loop control (Step 7) ----
// COMMENT FLAG: max_bounces — 0 = unbounded (Russian roulette only)
uniform int   u_max_bounces;
// COMMENT FLAG: rr_start_depth — Russian roulette begins past this depth
uniform int   u_rr_start_depth;
uniform uint  u_sample_index;       // per-sample RNG seed offset
uniform bool  u_debug_delta_only;   // true = Step 6 visual mode (white/sky)

// ---- sun params (Step 8) ----
uniform vec3  u_sun_direction;     // unit, scene -> sun
uniform vec3  u_sun_color;         // sun color RGB
uniform float u_sun_intensity;     // sun radiance multiplier

// ---- density (trilinear filtered sampler) ----
uniform sampler3D u_density;

// ---- majorant grid (nearest-filtered sampler, coarse resolution) ----
uniform sampler3D u_majorant;
uniform ivec3     u_majorant_resolution;  // e.g. (32, 32, 32)

// ---- output image ----
layout(rgba16f, binding = 0) writeonly uniform image2D img_output;

// ---- accumulation image (Step 9) ----
// When u_accumulate is true, samples are additively accumulated into
// img_accum (rgba32f, read-write).  When false, the shader writes
// directly to img_output (rgba16f, writeonly) as in Steps 5–8.
layout(rgba32f, binding = 1) uniform image2D img_accum;
uniform bool u_accumulate;


// ====================================================================
// Helper: evaluate sigma_t_rgb at a world-space position.
//
// sigma_t = extinction_rgb * density_scale * physical_density(p)
// where physical_density = raw_density / voxel_volume  (density
// normalization convention — applied here and in the majorant build,
// nowhere else).
// ====================================================================
vec3 sigma_t_at(vec3 p) {
    vec3 uvw = (p - u_bounds_min) / (u_bounds_max - u_bounds_min);
    float raw_density = texture(u_density, uvw).r;
    float physical_density = raw_density / u_voxel_volume;
    return u_extinction_rgb * u_density_scale * physical_density;
}


// ====================================================================
// Delta-tracked free flight with weighted null-scattering (RGB).
//
// Walks the ray through the coarse majorant grid.  Within each coarse
// cell, samples tentative free-flight distances from the local
// majorant.  On a tentative event, evaluates the true extinction and
// stochastically accepts (real collision) or rejects (null collision),
// updating the RGB throughput either way for unbiased estimation.
//
// Returns true  if a real collision occurred (position in `hit_pos`).
// Returns false if the ray escaped the grid with no real collision.
//
// `throughput` is an inout RGB weight — caller initializes to vec3(1).
// The weighted delta-tracking factors keep colored extinction unbiased
// under a single scalar accept/reject decision.
//
// Steps 7–8 call this to find collision points, then handle scattering
// and NEE at the collision site.
// ====================================================================
bool sample_free_flight(vec3 origin, vec3 dir,
                        float t_enter, float t_exit,
                        inout vec3 throughput,
                        out vec3 hit_pos)
{
    float t = t_enter;

    // Coarse cell size in world space
    vec3 grid_extent = u_bounds_max - u_bounds_min;
    vec3 cell_size   = grid_extent / vec3(u_majorant_resolution);

    // Max extinction channel (constant across the ray)
    float max_ext = max(u_extinction_rgb.r,
                    max(u_extinction_rgb.g, u_extinction_rgb.b));

    // Precompute inverse direction for slab math
    vec3 inv_dir = 1.0 / dir;

    // COMMENT FLAG: MAX_DT_ITERS — safety cap on total delta-tracking
    // iterations.  Should never be reached in practice; increase if
    // the majorant grid is very fine or rays are very long.
    const int MAX_DT_ITERS = 2048;

    for (int iter = 0; iter < MAX_DT_ITERS; iter++) {

        // ---- Have we left the volume? ----
        if (t >= t_exit)
            return false;

        // ---- Current position on the ray ----
        vec3 p = origin + t * dir;

        // ---- Identify the coarse cell containing p ----
        vec3 coarse_gc = (p - u_bounds_min) / cell_size;
        ivec3 cell = ivec3(floor(coarse_gc));
        cell = clamp(cell, ivec3(0), u_majorant_resolution - 1);

        // ---- Parametric t at which the ray exits this cell ----
        vec3 cell_world_min = u_bounds_min + vec3(cell) * cell_size;
        vec3 cell_world_max = cell_world_min + cell_size;

        vec3 t_to_min = (cell_world_min - origin) * inv_dir;
        vec3 t_to_max = (cell_world_max - origin) * inv_dir;
        vec3 t_exit_planes = max(t_to_min, t_to_max);

        float t_cell_exit = min(t_exit_planes.x,
                            min(t_exit_planes.y, t_exit_planes.z));
        t_cell_exit = min(t_cell_exit, t_exit);
        // Guarantee forward progress: cell exit must be strictly ahead of t.
        // Prevents infinite loops when ray is near-parallel to cell boundaries.
        t_cell_exit = max(t_cell_exit, t + 1e-5);

        // ---- Look up majorant for this cell ----
        // Sample at cell center — nearest filtering reads the stored max.
        vec3 cell_center_uvw = (vec3(cell) + 0.5) / vec3(u_majorant_resolution);
        float majorant_density = texture(u_majorant, cell_center_uvw).r;
        float mu_bar = max_ext * u_density_scale * majorant_density;

        // ---- Empty cell: skip straight to boundary ----
        if (mu_bar <= 0.0) {
            t = t_cell_exit + 1e-5;
            continue;
        }

        // ---- Delta tracking within this cell ----
        bool left_cell = false;
        while (!left_cell) {
            // Sample exponential free-flight distance
            float xi = next_float();
            xi = max(xi, 1e-30);            // guard log(0)
            float dt = -log(1.0 - xi) / mu_bar;
            t += dt;

            // Overshot cell boundary → advance to next cell
            if (t >= t_cell_exit) {
                t = t_cell_exit + 1e-5;
                left_cell = true;
                break;
            }

            // Overshot volume → escaped
            if (t >= t_exit)
                return false;

            // ---- Tentative event at this position ----
            vec3 event_pos = origin + t * dir;
            vec3 sigma_t   = sigma_t_at(event_pos);

            // Scalar real-collision probability
            float sigma_max = max(sigma_t.r, max(sigma_t.g, sigma_t.b));
            float Pr = clamp(sigma_max / mu_bar, 0.0, 1.0);

            float xi2 = next_float();

            if (xi2 < Pr) {
                // ---- Real collision ----
                // Throughput weight: sigma_t / (mu_bar * Pr)
                throughput *= sigma_t / (mu_bar * Pr);
                hit_pos = event_pos;
                return true;
            } else {
                // ---- Null collision ----
                // Throughput weight: (mu_bar - sigma_t) / (mu_bar * (1 - Pr))
                float one_minus_Pr = max(1.0 - Pr, 1e-10);
                vec3 null_weight = (mu_bar - sigma_t) / (mu_bar * one_minus_Pr);
                // COMMENT FLAG: null_weight_clamp — cap per-channel null-collision
                // weight to reduce fireflies with strongly chromatic extinction.
                // Introduces slight bias but controls variance explosion.
                throughput *= clamp(null_weight, vec3(0.0), vec3(5.0));
            }
        }
    }

    // Safety: exceeded MAX_DT_ITERS (should not happen in practice)
    return false;
}


// ====================================================================
// Ratio-tracked transmittance toward the sun (RGB, unbiased).
//
// Marches from world-space position `x` along u_sun_direction until
// the ray exits the grid, accumulating the ratio-tracking weight at
// each tentative event.  Unlike delta tracking (sample_free_flight),
// ratio tracking does NOT make a real/null decision — every tentative
// event multiplicatively updates T.  This produces an unbiased RGB
// transmittance estimate with naturally colored shadows.
//
// T starts at vec3(1).  At each tentative event position x':
//   T *= (mu_bar_cell - sigma_t_rgb(x')) / mu_bar_cell
//
// Returns T after the ray exits the grid.
// ====================================================================
vec3 transmittance_to_sun(vec3 x) {
    vec3 dir = u_sun_direction;

    // Intersect the shadow ray with the grid AABB
    float t_near, t_far;
    bool hit = intersect_aabb(x, dir, u_bounds_min, u_bounds_max,
                              t_near, t_far);
    if (!hit)
        return vec3(1.0);   // outside grid entirely

    // Origin is inside the grid, so t_near <= 0.
    // Start slightly ahead to avoid self-intersection.
    float t = max(t_near, 1e-5);

    vec3 T = vec3(1.0);

    // Coarse cell size in world space
    vec3 grid_extent = u_bounds_max - u_bounds_min;
    vec3 cell_size   = grid_extent / vec3(u_majorant_resolution);

    // Max extinction channel (constant)
    float max_ext = max(u_extinction_rgb.r,
                    max(u_extinction_rgb.g, u_extinction_rgb.b));

    // Precompute inverse direction for slab math
    vec3 inv_dir = 1.0 / dir;

    // COMMENT FLAG: MAX_SHADOW_ITERS — safety cap on ratio-tracking
    // iterations along the shadow ray.  Should never be reached in
    // practice; increase if the majorant grid is very fine.
    const int MAX_SHADOW_ITERS = 2048;

    for (int iter = 0; iter < MAX_SHADOW_ITERS; iter++) {

        // ---- Have we left the volume? ----
        if (t >= t_far)
            return T;

        // ---- Current position on the ray ----
        vec3 p = x + t * dir;

        // ---- Identify the coarse cell containing p ----
        vec3 coarse_gc = (p - u_bounds_min) / cell_size;
        ivec3 cell = ivec3(floor(coarse_gc));
        cell = clamp(cell, ivec3(0), u_majorant_resolution - 1);

        // ---- Parametric t at which the ray exits this cell ----
        vec3 cell_world_min = u_bounds_min + vec3(cell) * cell_size;
        vec3 cell_world_max = cell_world_min + cell_size;

        vec3 t_to_min = (cell_world_min - x) * inv_dir;
        vec3 t_to_max = (cell_world_max - x) * inv_dir;
        vec3 t_exit_planes = max(t_to_min, t_to_max);

        float t_cell_exit = min(t_exit_planes.x,
                            min(t_exit_planes.y, t_exit_planes.z));
        t_cell_exit = min(t_cell_exit, t_far);
        // Guarantee forward progress (same fix as sample_free_flight)
        t_cell_exit = max(t_cell_exit, t + 1e-5);

        // ---- Look up majorant for this cell ----
        vec3 cell_center_uvw = (vec3(cell) + 0.5) / vec3(u_majorant_resolution);
        float majorant_density = texture(u_majorant, cell_center_uvw).r;
        float mu_bar = max_ext * u_density_scale * majorant_density;

        // ---- Empty cell: skip straight to boundary ----
        if (mu_bar <= 0.0) {
            t = t_cell_exit + 1e-5;
            continue;
        }

        // ---- Ratio tracking within this cell ----
        bool left_cell = false;
        while (!left_cell) {
            // Sample exponential free-flight distance
            float xi = next_float();
            xi = max(xi, 1e-30);            // guard log(0)
            float dt = -log(1.0 - xi) / mu_bar;
            t += dt;

            // Overshot cell boundary → advance to next cell
            if (t >= t_cell_exit) {
                t = t_cell_exit + 1e-5;
                left_cell = true;
                break;
            }

            // Overshot volume → done
            if (t >= t_far)
                return T;

            // ---- Tentative event: ratio-tracking weight update ----
            // T *= (mu_bar - sigma_t) / mu_bar   (per channel)
            // No real/null decision — every event contributes.
            vec3 event_pos = x + t * dir;
            vec3 sigma_t   = sigma_t_at(event_pos);
            T *= clamp((mu_bar - sigma_t) / mu_bar, vec3(0.0), vec3(1.0));

            // Early termination: if T is negligibly small, stop
            if (max(T.r, max(T.g, T.b)) < 1e-6)
                return T;
        }
    }

    // Safety: exceeded MAX_SHADOW_ITERS
    return T;
}


// ====================================================================
// Sample a direction uniformly on the unit sphere.
//
// Analytic cos-theta / sin-theta method: branchless, exactly 2 random
// draws, no rejection waste.  Used for isotropic phase function.
// ====================================================================
vec3 sample_sphere() {
    float xi1 = next_float();
    float xi2 = next_float();
    float cos_theta = 1.0 - 2.0 * xi1;          // uniform in [-1, +1]
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 6.283185307 * xi2;               // 2*pi
    return vec3(sin_theta * cos(phi),
                sin_theta * sin(phi),
                cos_theta);
}


// ====================================================================
// Accumulate-aware output: adds to img_accum when accumulating,
// writes to img_output otherwise.  (Step 9)
// ====================================================================
void write_output(ivec2 pixel, vec4 value) {
    if (u_accumulate) {
        imageStore(img_accum, pixel, imageLoad(img_accum, pixel) + value);
    } else {
        imageStore(img_output, pixel, value);
    }
}


void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= u_target_size.x || pixel.y >= u_target_size.y)
        return;

    // ---- 1. Build NDC at pixel center ----
    vec2 uv = (vec2(pixel) + 0.5) / vec2(u_target_size);
    vec2 ndc_xy = uv * 2.0 - 1.0;

    // ---- 2. Unproject near (z=-1) and far (z=+1) through inv_view_proj ----
    vec4 near_h = u_inv_view_proj * vec4(ndc_xy, -1.0, 1.0);
    vec4 far_h  = u_inv_view_proj * vec4(ndc_xy,  1.0, 1.0);
    vec3 near_w = near_h.xyz / near_h.w;
    vec3 far_w  = far_h.xyz / far_h.w;

    // ---- 3. Ray ----
    vec3 ray_origin = near_w;
    vec3 ray_dir    = normalize(far_w - near_w);

    // ---- 4. AABB slab intersection ----
    float t_near, t_far;
    bool hit = intersect_aabb(ray_origin, ray_dir,
                              u_bounds_min, u_bounds_max,
                              t_near, t_far);

    vec3 sky = u_sky_color * u_sky_intensity;

    if (!hit) {
        write_output(pixel, vec4(sky, 1.0));
        return;
    }

    // ---- 5. Debug fixed-step raymarch ----
    if (u_debug_raymarch) {
        // Clamp t_near so camera can be inside the box
        t_near = max(t_near, 0.0);
        float path_length = t_far - t_near;
        float step_size = path_length / float(u_debug_steps);

        vec3 tau = vec3(0.0);  // optical depth accumulator (RGB)

        for (int i = 0; i < u_debug_steps; i++) {
            float t = t_near + (float(i) + 0.5) * step_size;
            vec3 p = ray_origin + t * ray_dir;

            // Normalized texture coords [0,1] for sampler3D
            vec3 uvw = (p - u_bounds_min) / (u_bounds_max - u_bounds_min);
            float raw_density = texture(u_density, uvw).r;
            float physical_density = raw_density / u_voxel_volume;

            vec3 sigma_t = u_extinction_rgb * u_density_scale * physical_density;
            tau += sigma_t * step_size;
        }

        // Transmittance composited over sky: color = sky * exp(-tau)
        // This is the "1 - exp(-tau_rgb)" alpha-over-sky composite.
        vec3 transmittance = exp(-tau);
        vec3 color = sky * transmittance;
        write_output(pixel, vec4(color, 1.0));
        return;
    }

    // ---- 6. Delta-tracked free flight (visual validation mode) ----
    // When u_debug_delta_only is set, use the Step 6 visual test:
    // single free flight, white on collision, sky on escape.
    if (u_debug_delta_only) {
        rng_init(uvec3(pixel, 0u));
        t_near = max(t_near, 0.0);

        vec3 throughput_dt = vec3(1.0);
        vec3 hit_pos_dt;
        bool collided = sample_free_flight(ray_origin, ray_dir,
                                           t_near, t_far,
                                           throughput_dt, hit_pos_dt);
        if (collided) {
            write_output(pixel, vec4(1.0, 1.0, 1.0, 1.0));
        } else {
            write_output(pixel, vec4(sky, 1.0));
        }
        return;
    }

    // ---- 7. Bounce loop (isotropic scattering, sky environment) ----
    // Full random walk with throughput, albedo absorption, and
    // Russian roulette termination.  The medium is lit purely by
    // the sky environment via escaped random walks.
    // Direct sun NEE is added in Step 8.

    rng_init(uvec3(pixel, u_sample_index));

    vec3 throughput = vec3(1.0);
    vec3 radiance   = vec3(0.0);
    int  depth      = 0;

    vec3  walk_origin = ray_origin;
    vec3  walk_dir    = ray_dir;
    float walk_t_near = max(t_near, 0.0);
    float walk_t_far  = t_far;

    // COMMENT FLAG: MAX_WALK_BOUNCES — absolute safety cap on walk length.
    // Should never be reached when max_bounces > 0 or RR is active.
    const int MAX_WALK_BOUNCES = 512;

    for (int bounce = 0; bounce < MAX_WALK_BOUNCES; bounce++) {

        // ---- Free flight ----
        vec3 dt_throughput = vec3(1.0);
        vec3 hit_pos;
        bool collided = sample_free_flight(walk_origin, walk_dir,
                                           walk_t_near, walk_t_far,
                                           dt_throughput, hit_pos);

        throughput *= dt_throughput;

        if (!collided) {
            // Escaped grid: add sky contribution.
            // Primary escape = visible background;
            // deeper escape = environment illumination of the medium.
            radiance += throughput * u_sky_color * u_sky_intensity;
            break;
        }

        // ---- Real collision at hit_pos ----
        // Fold absorption: throughput *= albedo
        throughput *= u_albedo_rgb;

        // ---- Sun NEE (Step 8): direct illumination at collision ----
        // Delta light, isotropic phase = 1/(4*pi).
        // throughput already includes albedo_rgb from the line above.
        {
            vec3 T_sun = transmittance_to_sun(hit_pos);
            float phase = 1.0 / (4.0 * 3.141592653589793);
            radiance += throughput * phase * T_sun * u_sun_color * u_sun_intensity;
        }

        depth += 1;

        // ---- Termination: max_bounces ----
        // COMMENT FLAG: max_bounces
        if (u_max_bounces > 0 && depth >= u_max_bounces) {
            break;
        }

        // ---- Termination: Russian roulette ----
        // COMMENT FLAG: rr_start_depth
        if (depth > u_rr_start_depth) {
            float p_survive = max(throughput.r, max(throughput.g, throughput.b));
            p_survive = clamp(p_survive, 0.05, 1.0);  // floor prevents fireflies
            if (next_float() >= p_survive) {
                break;
            }
            throughput /= p_survive;
        }

        // ---- Scatter: uniform sphere direction (isotropic phase) ----
        walk_dir = sample_sphere();

        // ---- Re-intersect AABB from collision point ----
        walk_origin = hit_pos;
        bool re_hit = intersect_aabb(walk_origin, walk_dir,
                                     u_bounds_min, u_bounds_max,
                                     walk_t_near, walk_t_far);

        if (!re_hit) {
            // New direction immediately leaves the volume → escape
            radiance += throughput * u_sky_color * u_sky_intensity;
            break;
        }

        // Origin is inside the box, so t_near <= 0.
        // Step forward slightly to avoid self-intersection.
        walk_t_near = max(walk_t_near, 1e-5);
    }

    write_output(pixel, vec4(radiance, 1.0));
}
