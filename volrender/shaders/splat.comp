#version 430
#extension GL_NV_shader_atomic_float : require

// Trilinear atomic splat — one invocation per entity.
// Deposits density and hue-color into the voxel grid.

layout(local_size_x = 256) in;

// ---- entity SSBO (flat float[], stride 8) ----
layout(std430, binding = 0) buffer EntityBuffer {
    float entities[];
};

uniform int u_entity_count;

// ---- common.glsl (prepended) provides: ----
// uniform vec3  u_bounds_min, u_bounds_max, u_resolution;
// uniform float u_voxel_volume;
// vec3 world_to_grid(vec3), vec3 grid_to_world(vec3)

// ---- image bindings ----
layout(r32f, binding = 0) uniform image3D img_density;

// Hue color accumulation [cos(2*pi*hue), sin(2*pi*hue)]
layout(r32f, binding = 1) uniform image3D img_color_x;
layout(r32f, binding = 2) uniform image3D img_color_y;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= u_entity_count) return;

    // Read entity (flat float array, stride 8)
    uint base = id * 8u;
    vec3 pos = vec3(entities[base], entities[base + 1u], entities[base + 2u]);
    // entities[base+3..5] = velocity (unused)
    float hue = entities[base + 6u];
    float entity_size = entities[base + 7u];

    // Size-proportional scaling: at DEFAULT_SIZE contribution is 1.0 (unchanged),
    // at zero the entity is skipped entirely.
    const float DEFAULT_SIZE = 0.0015;
    float size_scale = entity_size / DEFAULT_SIZE;
    if (size_scale <= 0.0) return;

    // Convert hue to unit vector for circular-mean accumulation
    float theta = 6.283185307 * hue;   // 2*pi*hue
    float cos_theta = cos(theta);
    float sin_theta = sin(theta);

    // Skip entities outside bounds
    if (any(lessThan(pos, u_bounds_min)) || any(greaterThanEqual(pos, u_bounds_max)))
        return;

    // Continuous grid coordinate
    vec3 gc = world_to_grid(pos);

    // The 8 surrounding voxel corner indices and trilinear weights.
    // gc is in [0, resolution).  Subtract 0.5 to center on voxels
    // (voxel i is centered at i+0.5 in grid coords), then floor.
    vec3 gc_shifted = gc - 0.5;
    ivec3 i0 = ivec3(floor(gc_shifted));   // lower corner
    vec3 f = gc_shifted - vec3(i0);        // fractional part in [0,1)

    // Trilinear weights
    float w[8];
    w[0] = (1.0 - f.x) * (1.0 - f.y) * (1.0 - f.z);
    w[1] = (      f.x) * (1.0 - f.y) * (1.0 - f.z);
    w[2] = (1.0 - f.x) * (      f.y) * (1.0 - f.z);
    w[3] = (      f.x) * (      f.y) * (1.0 - f.z);
    w[4] = (1.0 - f.x) * (1.0 - f.y) * (      f.z);
    w[5] = (      f.x) * (1.0 - f.y) * (      f.z);
    w[6] = (1.0 - f.x) * (      f.y) * (      f.z);
    w[7] = (      f.x) * (      f.y) * (      f.z);

    // Offsets for the 8 corners
    ivec3 offsets[8] = ivec3[8](
        ivec3(0,0,0), ivec3(1,0,0), ivec3(0,1,0), ivec3(1,1,0),
        ivec3(0,0,1), ivec3(1,0,1), ivec3(0,1,1), ivec3(1,1,1)
    );

    ivec3 res = ivec3(u_resolution);

    // Deposit into the 8 surrounding voxels
    for (int c = 0; c < 8; c++) {
        ivec3 voxel = i0 + offsets[c];

        // Clamp to valid range
        if (any(lessThan(voxel, ivec3(0))) || any(greaterThanEqual(voxel, res)))
            continue;

        float wt = w[c];
        if (wt <= 0.0) continue;

        float deposit = wt * size_scale;
        imageAtomicAdd(img_density, voxel, deposit);
        imageAtomicAdd(img_color_x, voxel, deposit * cos_theta);
        imageAtomicAdd(img_color_y, voxel, deposit * sin_theta);
    }
}
