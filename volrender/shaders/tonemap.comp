#version 430

// tonemap.comp — apply exposure + Reinhard tonemap + gamma to resolved HDR.
//
//   exposed = rgb * exposure
//   ldr     = exposed / (1 + exposed)     (Reinhard)
//   output  = pow(ldr, 1/2.2)             (gamma)
//
// Reads linear HDR from img_input (rgba16f), writes LDR to img_output (rgba8).

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly  uniform image2D img_input;
layout(rgba8,   binding = 1) writeonly uniform image2D img_output;

uniform ivec2 u_target_size;
uniform float u_exposure;   // Tracer exposure slider (default 1.5)

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= u_target_size.x || pixel.y >= u_target_size.y)
        return;

    vec4 hdr = imageLoad(img_input, pixel);
    vec3 rgb = hdr.rgb;

    // Exposure + Reinhard tonemap
    rgb *= u_exposure;
    rgb = rgb / (1.0 + rgb);

    // Gamma correction (sRGB approximate)
    rgb = pow(clamp(rgb, 0.0, 1.0), vec3(1.0 / 2.2));

    // Flip Y: OpenGL image y=0 is bottom, imgui expects y=0 at top.
    ivec2 out_pixel = ivec2(pixel.x, u_target_size.y - 1 - pixel.y);
    imageStore(img_output, out_pixel, vec4(rgb, 1.0));
}
